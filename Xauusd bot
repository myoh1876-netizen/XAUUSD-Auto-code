
//+------------------------------------------------------------------+
//| XAUUSD M1 Auto Trading Bot                                      |
//| Demo testing version                                            |
//+------------------------------------------------------------------+
#include <Trade/Trade.mqh>

CTrade trade;

input double Lots = 0.01;
input int FastEMA = 9;
input int SlowEMA = 21;
input int ATRPeriod = 14;
input double SL_ATR = 1.5;
input double TP_ATR = 2.0;
input ulong MagicNumber = 20261107;

int fastHandle, slowHandle, atrHandle;
datetime lastBar = 0;

//+------------------------------------------------------------------+
int OnInit()
{
   fastHandle = iMA(_Symbol, PERIOD_M1, FastEMA, 0,
                    MODE_EMA, PRICE_CLOSE);

   slowHandle = iMA(_Symbol, PERIOD_M1, SlowEMA, 0,
                    MODE_EMA, PRICE_CLOSE);

   atrHandle = iATR(_Symbol, PERIOD_M1, ATRPeriod);

   if(fastHandle == INVALID_HANDLE ||
      slowHandle == INVALID_HANDLE ||
      atrHandle == INVALID_HANDLE)
      return INIT_FAILED;

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFillingBySymbol(_Symbol);
   trade.SetDeviationInPoints(20);

   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(fastHandle);
   IndicatorRelease(slowHandle);
   IndicatorRelease(atrHandle);
}

//+------------------------------------------------------------------+
void OnTick()
{
   datetime bar = iTime(_Symbol, PERIOD_M1, 0);

   if(bar == 0 || bar == lastBar)
      return;

   lastBar = bar;

   // One position at a time
   if(PositionSelect(_Symbol))
      return;

   double fast1[1], fast2[1];
   double slow1[1], slow2[1];
   double atr[1];

   if(CopyBuffer(fastHandle, 0, 1, 1, fast1) != 1) return;
   if(CopyBuffer(fastHandle, 0, 2, 1, fast2) != 1) return;
   if(CopyBuffer(slowHandle, 0, 1, 1, slow1) != 1) return;
   if(CopyBuffer(slowHandle, 0, 2, 1, slow2) != 1) return;
   if(CopyBuffer(atrHandle, 0, 1, 1, atr) != 1) return;

   if(atr[0] <= 0) return;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   long stopsLevel = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);
   double minDistance = (stopsLevel + 2) * point;

   double slDistance = MathMax(atr[0] * SL_ATR, minDistance);
   double tpDistance = MathMax(atr[0] * TP_ATR, minDistance);

   // BUY: Fast EMA crosses above Slow EMA
   if(fast2[0] <= slow2[0] && fast1[0] > slow1[0])
   {
      double sl = NormalizeDouble(ask - slDistance, digits);
      double tp = NormalizeDouble(ask + tpDistance, digits);

      trade.Buy(Lots, _Symbol, 0, sl, tp, "M1 EMA BUY");
   }

   // SELL: Fast EMA crosses below Slow EMA
   if(fast2[0] >= slow2[0] && fast1[0] < slow1[0])
   {
      double sl = NormalizeDouble(bid + slDistance, digits);
      double tp = NormalizeDouble(bid - tpDistance, digits);

      trade.Sell(Lots, _Symbol, 0, sl, tp, "M1 EMA SELL");
   }
}
//+------------------------------------------------------------------+
auto bot
